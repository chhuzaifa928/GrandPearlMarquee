# Frontend API base URL
#
# Used by client/src/config/api.js to reach the backend.
# Leave the default value for local development:
VITE_API_URL=http://localhost:5000
#
# For production, set VITE_API_URL to the deployed backend API URL
# (e.g. https://your-api-domain) before building. Vite bakes this value
# into the bundle, so it must be set at build time.
