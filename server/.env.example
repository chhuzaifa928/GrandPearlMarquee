PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Set to true when the production MySQL provider requires SSL/TLS
DB_SSL=false
# If SSL is enabled, provide the CA certificate.
# Use \n for line breaks when storing it in one environment-variable line.
DB_SSL_CA=

JWT_SECRET=

FRONTEND_URL=

# Set to true when running behind a reverse proxy (e.g. Hostinger)
# Enables correct client IP detection for rate limiting
TRUST_PROXY=false
